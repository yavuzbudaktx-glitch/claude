{
  "manifest_version": 3,
  "name": "YouTube Comment Grabber",
  "version": "1.3.4",
  "description": "One click to pull all comments of the YouTube video you're watching, with search, timestamp seek, sorting, analytics and export.",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open YouTube Comment Grabber",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
