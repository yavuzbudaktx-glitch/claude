NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Bypasses RLS — used by /api/agent/* routes for device-token auth.
# Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

GOOGLE_CLIENT_ID=YOUR-GOOGLE-OAUTH-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR-GOOGLE-OAUTH-CLIENT-SECRET

# YouTube Data API v3 key — makes the "Long view" / CPA video libraries
# reliable. Scraping youtube.com from a server IP gets the bot/consent wall,
# so without this the libraries fall back to flaky public mirrors and often
# come back short. Create one in Google Cloud Console → APIs & Services →
# Credentials → API key, then enable "YouTube Data API v3" for the project.
# Free quota (10,000 units/day) is far more than this needs.
YOUTUBE_API_KEY=YOUR-YOUTUBE-DATA-API-V3-KEY

NEXT_PUBLIC_SITE_URL=http://localhost:3000
